{
  "expo": {
    "name": "lostandfound-app",
    "slug": "lostandfound-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.antoniskol.lostandfound-app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#2B2D30",
          "imageWidth": 200
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Fundstück uses your location to show lost and found items near you.",
          "locationAlwaysAndWhenInUsePermission": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      "./plugins/withIosSceneLifecycle"
    ]
  }
}
